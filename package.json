{
  "name": "veritas-evidence-workbench",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "test": "node --experimental-strip-types --test tests/engine.test.mjs tests/request.test.mjs",
    "test:integration": "node scripts/test-api.mjs",
    "typecheck": "tsc --noEmit",
    "db:local": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"lib/**/*.ts\" \"db/**/*.ts\" \"tests/*.mjs\" \"scripts/*.mjs\" \"*.md\" \"docs/**/*.md\" \".github/**/*.{yml,md}\" \"package.json\" \"next.config.ts\" \"vercel.json\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"lib/**/*.ts\" \"db/**/*.ts\" \"tests/*.mjs\" \"scripts/*.mjs\" \"*.md\" \"docs/**/*.md\" \".github/**/*.{yml,md}\" \"package.json\" \"next.config.ts\" \"vercel.json\"",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "prettier": "^3.9.10",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
